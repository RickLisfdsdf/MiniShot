        Square150x150Logo="logo.png" Square44x44Logo="logo.png" AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="MiniShotPaste" Clsid="6B1E3F52-9C1A-4F8E-A7D2-3C5B9E4A1F70" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="MiniShot 右键菜单">
              <com:Class Id="6B1E3F52-9C1A-4F8E-A7D2-3C5B9E4A1F70" Path="MiniShotMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
